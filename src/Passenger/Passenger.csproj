<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="5.9.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <PackageReference Include="Patchright" Version="1.62.1" />
  </ItemGroup>


  <!--
    Embedded rather than installed beside the binary, and none of it is code the
    caller could run. viewer.html
    is the page a human takes the browser over in, served by this process, so
    embedding it means a single-file publish still serves it and there is no
    path to get wrong when the tool is installed outside a source tree.

    pictures.js used to be here too, and the comment in this place argued at
    length that it belonged: the tool ran it on every read and reported the
    numbers whether or not the caller asked, on ticket 017's finding that a
    photograph is the one thing a caller cannot recover from the text it was
    handed. Ticket 048 declined that argument rather than refuting it. The
    measurement is the caller's now, so pictures.js ships in the skill beside
    markdown.js. The line this comment drew between them is gone; both are
    recipes the caller runs.
  -->
  <!--
    The session templates are files rather than string literals in Launch.cs, so
    that a shell script is a shell script: highlighted, diffable, and something
    shellcheck can be pointed at. They carry {braces} that Launch substitutes,
    which is the one thing that keeps them from running as they stand.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Assets/web/viewer.html" LogicalName="Passenger.viewer.html" />
    <EmbeddedResource Include="Assets/session/session.sh" LogicalName="Passenger.session.sh" />
    <EmbeddedResource Include="Assets/session/ime.sh" LogicalName="Passenger.ime.sh" />
    <EmbeddedResource Include="Assets/session/sway.conf" LogicalName="Passenger.sway.conf" />
  </ItemGroup>

</Project>
