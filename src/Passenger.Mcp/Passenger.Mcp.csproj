<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Passenger\Passenger.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <!--
      A fork, not nuget.org's 2.2.0: upstream writes the JSON-RPC envelope
      with an encoder that escapes every non-ASCII character to \uXXXX, and
      offers no hook to change it (ticket 056, csharp-sdk#795). The fork adds
      McpServerOptions.JsonSerializerOptions, which Program.cs sets. The
      packages are built by the flake and restored from a local source; see
      MCP_SDK_NUGET_SOURCE in Directory.Build.props.
    -->
    <PackageReference Include="ModelContextProtocol" Version="2.2.0-utf8wire.1" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
