{
  "name": "passenger",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "An MCP server that hands agents web pages through a real, logged-in Chrome",
  "bin": { "passenger": "src/cli/Entry.res.mjs" },
  "scripts": {
    "build": "rescript build",
    "watch": "rescript build -w",
    "clean": "rescript clean",
    "start": "node src/cli/Entry.res.mjs",
    "compile": "bash scripts/compile.sh",
    "test": "rescript build && node --test test/*_test.res.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@rescript/runtime": "12.3.1",
    "playwright-core": "^1.62.1"
  },
  "devDependencies": {
    "rescript": "^12.3.1"
  }
}
