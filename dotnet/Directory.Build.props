<Project>

  <!--
    The Python side runs mypy strict with warn_unreachable, and ticket 023
    recorded that as a stricter contract than the port gets for free. This is
    the nearest equivalent: nullable reference types on, and every warning an
    error, so the compiler refuses the same shapes mypy refuses rather than
    mentioning them.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <InvariantGlobalization>true</InvariantGlobalization>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!--
    Linux, and not as an accident of where it was written. cage and wayvnc are
    Wayland, /proc is how a session's liveness is read, and kill(2) with an
    explicit signal is how it is torn down. Declaring it means the platform
    analyser checks the rest of the code against that promise instead of
    warning about every call that keeps it.
  -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatform">
      <_Parameter1>linux</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
