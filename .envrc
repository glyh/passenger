# Load the flake's dev shell on entering this directory.
#
# nix-direnv (if wired into ~/.config/direnv/direnvrc) caches the evaluation
# and registers a GC root so `nix-collect-garbage` cannot rip the shell out
# from under you. Without it plain `use flake` still works -- just slower, and
# re-evaluated more often.
use flake

# Rebuild the shell when the pin moves, not only when flake.nix is edited.
watch_file flake.lock
